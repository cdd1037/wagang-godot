{"file":"R_01.wagan","kind":"story","scenario_index":2,"version":[1,2],"tlv":[],"scenes":[{"index":0,"offset":30,"sections":[{"index":0,"offset":32,"title":"柴嗣昌寻山访隐","conditions":[{"op":2,"name":"comment","args":["柴嗣昌寻山访隐"]},{"op":0,"name":"end","args":[]}],"body":[{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_result","args":[0]},{"op":36,"name":"play_sound","args":[3]},{"op":39,"name":"change_scene","args":[2,65535,65535,70,65535]},{"op":48,"name":"actor_appear","args":[0,46,94,0,0]},{"op":48,"name":"actor_appear","args":[21,54,6,2,0]},{"op":24,"name":"title_text","args":["将星传说"]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["牧龙谷  东侧出口"]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,0,0,46,50,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[0,65535,2]},{"op":20,"name":"dialog","args":["&管毅\n呼，到这里总算脱险了。"]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[702]]},"end":24},{"op":51,"name":"actor_face","args":[0,65535,1]},{"op":20,"name":"dialog","args":["&管毅\n（只是不知定方现在怎样…）"]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[0,65535,2]},{"op":20,"name":"dialog","args":["&管毅\n（嗯…定方武艺高强，而且聪明\n绝顶，现在应该也已经脱险了。\n我还是尽早赶去潞州等他吧。）"]},{"op":51,"name":"actor_face","args":[0,65535,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[702],[]]},"end":32},{"op":20,"name":"dialog","args":["&管毅\n（名叫尚师徒的那员将官\n武艺奇高，即使定方与他交手，\n恐怕也是凶多吉少…）\n&管毅\n（刚才竟能全身而退，\n一定是老师的在天之灵保佑…）"]},{"op":52,"name":"actor_action","args":[0,11]},{"op":20,"name":"dialog","args":["&管毅\n（老师，弟子此去，不知何年\n何月才能再回来拜祭您了…\n请再受弟子一拜吧！）"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":0,"name":"end","args":[]},{"op":9,"name":"delay","args":[5]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[65535,0,0,46,44,0]},{"op":50,"name":"actor_move","args":[65535,21,0,54,44,2]},{"op":9,"name":"delay","args":[0]},{"op":51,"name":"actor_face","args":[21,6,3]},{"op":51,"name":"actor_face","args":[0,65535,1]},{"op":20,"name":"dialog","args":["&柴绍\n敢问这位兄台，\n穿过前面那片树林，\n是不是就到了牧龙谷？"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["头像变化（管毅怒·新）"]},"end":45},{"op":120,"name":"data_transfer","args":[0,0,0,1]},{"op":119,"name":"int_var_op","args":[2,0,2,0,2]},{"op":120,"name":"data_transfer","args":[0,1,0,1]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&管毅\n！！\n（他怎会知道牧龙谷的秘密入口！？）"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["头像变化（管毅正常·新）"]},"end":51},{"op":120,"name":"data_transfer","args":[0,0,0,1]},{"op":119,"name":"int_var_op","args":[2,0,2,0,0]},{"op":120,"name":"data_transfer","args":[0,1,0,1]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&管毅\n公子要去牧龙谷？\n&柴绍\n啊，正是。\n&管毅\n（此人看起来也是官宦出身…）"]},{"op":36,"name":"play_sound","args":[11]},{"op":1,"name":"if","args":[],"cond":{"op":18,"name":"choice","args":["骗对方离开\n劝对方离开",65535]},"end":115},{"op":1,"name":"if","args":[],"cond":{"op":19,"name":"test_choice","args":[1]},"end":74},{"op":58,"name":"set_resource","args":[2,1,1]},{"op":119,"name":"int_var_op","args":[2,1009,1,0,1]},{"op":36,"name":"play_sound","args":[3]},{"op":20,"name":"dialog","args":["&管毅\n（嗯，不能向来历不明的人\n泄露牧龙谷的秘密…）"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&管毅\n看来公子是走错路了。"]},{"op":51,"name":"actor_face","args":[0,65535,3]},{"op":52,"name":"actor_action","args":[21,0]},{"op":20,"name":"dialog","args":["&管毅\n牧龙谷的入口只有一个，\n由此向北穿过森林，再向西行就到了。"]},{"op":51,"name":"actor_face","args":[0,65535,1]},{"op":52,"name":"actor_action","args":[21,3]},{"op":20,"name":"dialog","args":["&柴绍\n哦！多亏兄台告知！\n在下进谷实有急用，\n若非遇到兄台，几乎误了大事…"]},{"op":20,"name":"dialog","args":["&管毅\n在下还要赶路，失礼了…"]},{"op":52,"name":"actor_action","args":[21,0]},{"op":51,"name":"actor_face","args":[21,65535,0]},{"op":50,"name":"actor_move","args":[65535,0,0,46,6,0]},{"op":51,"name":"actor_face","args":[21,3,0]},{"op":20,"name":"dialog","args":["&柴绍\n多谢兄台了！"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":19,"name":"test_choice","args":[2]},"end":114},{"op":58,"name":"set_resource","args":[2,2,1]},{"op":119,"name":"int_var_op","args":[2,1009,0,0,1]},{"op":36,"name":"play_sound","args":[3]},{"op":20,"name":"dialog","args":["&管毅\n（既没盔甲也无兵刃，\n好像与官兵不是一路的…）"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&管毅\n…公子还是速速离开的好。"]},{"op":52,"name":"actor_action","args":[21,0]},{"op":20,"name":"dialog","args":["&柴绍\n哦？\n&管毅\n卧虎山已经成了官兵的战场，\n现在进谷恐怕是有去无回。"]},{"op":52,"name":"actor_action","args":[21,3]},{"op":20,"name":"dialog","args":["&柴绍\n啊？！"]},{"op":51,"name":"actor_face","args":[21,0,2]},{"op":20,"name":"dialog","args":["&柴绍\n我到底还是来晚了么？这…"]},{"op":20,"name":"dialog","args":["&管毅\n在下还要赶路，失礼了。"]},{"op":51,"name":"actor_face","args":[0,65535,0]},{"op":51,"name":"actor_face","args":[21,0,3]},{"op":20,"name":"dialog","args":["&柴绍\n哎？这位兄台，你是…"]},{"op":51,"name":"actor_face","args":[21,0,0]},{"op":50,"name":"actor_move","args":[65535,0,0,46,6,0]},{"op":51,"name":"actor_face","args":[21,3,0]},{"op":20,"name":"dialog","args":["&柴绍\n兄台请留步！…"]},{"op":52,"name":"actor_action","args":[21,0]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[21,0,2]},{"op":9,"name":"delay","args":[5]},{"op":50,"name":"actor_move","args":[65535,21,0,54,50,2]},{"op":9,"name":"delay","args":[5]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["头像变化（柴绍哭）"]},"end":106},{"op":120,"name":"data_transfer","args":[0,0,21,1]},{"op":119,"name":"int_var_op","args":[2,0,2,0,293]},{"op":120,"name":"data_transfer","args":[0,1,21,1]},{"op":0,"name":"end","args":[]},{"op":52,"name":"actor_action","args":[21,4]},{"op":20,"name":"dialog","args":["&柴绍\n唉…\n让我如何向老千岁交待…"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["头像变化（柴绍正常）"]},"end":113},{"op":120,"name":"data_transfer","args":[0,0,21,1]},{"op":119,"name":"int_var_op","args":[2,0,2,0,25]},{"op":120,"name":"data_transfer","args":[0,1,21,1]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":9,"name":"delay","args":[5]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":9,"name":"delay","args":[10]},{"op":47,"name":"op_2f","args":[]},{"op":36,"name":"play_sound","args":[64]},{"op":24,"name":"title_text","args":[""]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":41,"name":"op_29","args":[153,564,60]},{"op":44,"name":"caption","args":["南陈遗老袁宪遭隋廷追杀，",1,0,0]},{"op":43,"name":"op_2b","args":[153]},{"op":44,"name":"caption","args":["殉身神飞崖。",1,0,1]},{"op":44,"name":"caption","args":["他的两名弟子——",1,1,1]},{"op":41,"name":"op_29","args":[0,500,100]},{"op":44,"name":"caption","args":["管毅、",1,0,0]},{"op":9,"name":"delay","args":[3]},{"op":41,"name":"op_29","args":[35,500,20]},{"op":44,"name":"caption","args":["苏烈",1,0,0]},{"op":9,"name":"delay","args":[3]},{"op":44,"name":"caption","args":["分别杀出牧龙谷，并约在山西潞州相会。",1,0,1]},{"op":42,"name":"op_2a","args":[0,320,100]},{"op":42,"name":"op_2a","args":[35,320,20]},{"op":44,"name":"caption","args":["乱世重现的预言是否将成为现实？",0,1,0]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["将星又将落在何方？",1,0,0]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["掌握着地下迷城图的两个年轻人，",1,1,0]},{"op":9,"name":"delay","args":[3]},{"op":44,"name":"caption","args":["踏上了他们的宿命之旅…",1,0,1]},{"op":44,"name":"caption","args":["请继续玩赏〖瓦岗山异闻录〗下一章——盟定贾家楼——",1,1,1]},{"op":9,"name":"delay","args":[5]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":9,"name":"delay","args":[10]},{"op":0,"name":"end","args":[]}]}]},{"index":1,"offset":3273,"sections":[{"index":0,"offset":3275,"title":"行废立文帝易东宫","conditions":[{"op":2,"name":"comment","args":["行废立文帝易东宫"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[66]},{"op":103,"name":"chapter_title","args":[1,"盟定贾家楼"]},{"op":9,"name":"delay","args":[20]},{"op":39,"name":"change_scene","args":[2,65535,65535,149,65535]},{"op":48,"name":"actor_appear","args":[100,48,42,2,0]},{"op":48,"name":"actor_appear","args":[160,54,42,2,0]},{"op":48,"name":"actor_appear","args":[56,60,42,2,0]},{"op":48,"name":"actor_appear","args":[55,66,42,2,0]},{"op":48,"name":"actor_appear","args":[940,48,66,0,0]},{"op":48,"name":"actor_appear","args":[49,54,66,0,0]},{"op":48,"name":"actor_appear","args":[33,60,66,0,0]},{"op":48,"name":"actor_appear","args":[46,66,66,0,0]},{"op":36,"name":"play_sound","args":[255]},{"op":9,"name":"delay","args":[10]},{"op":28,"name":"fade_out","args":[]},{"op":36,"name":"play_sound","args":[13]},{"op":9,"name":"delay","args":[3]},{"op":24,"name":"title_text","args":["唐公辞京"]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["大兴京  金銮殿"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[940,65535,1]},{"op":51,"name":"actor_face","args":[49,65535,3]},{"op":20,"name":"dialog","args":["&伍建章\n李渊啊，你猜陛下深夜升殿，\n召见我等所为何事？"]},{"op":52,"name":"actor_action","args":[49,6]},{"op":20,"name":"dialog","args":["&李渊\n回千岁的话，卑职实在猜不到。"]},{"op":52,"name":"actor_action","args":[49,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[940,65535,0]},{"op":20,"name":"dialog","args":["&伍建章\n…最近陛下好像越来越疏远老夫了。\n本想向消息灵通的李大人问一问其中\n根由…哼，谁知道你也如此搪塞老夫！"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[49,6]},{"op":20,"name":"dialog","args":["&李渊\n老千岁这样说可真是屈杀李渊了。\n满朝上下尽人皆知卑职是您老的门生。\n&李渊\n如今陛下疏远老千岁，\n对卑职自然也是白眼有加。\n卑职哪还有机会去探听陛下的口风呢？"]},{"op":51,"name":"actor_face","args":[940,65535,1]},{"op":20,"name":"dialog","args":["&伍建章\n这倒也是。\n老夫心直口快，李大人不要介意。\n不过，真的一点风声都打听不到么？"]},{"op":52,"name":"actor_action","args":[49,0]},{"op":51,"name":"actor_face","args":[49,0,0]},{"op":9,"name":"delay","args":[7]},{"op":51,"name":"actor_face","args":[49,0,1]},{"op":9,"name":"delay","args":[7]},{"op":51,"name":"actor_face","args":[49,0,2]},{"op":9,"name":"delay","args":[7]},{"op":51,"name":"actor_face","args":[49,0,3]},{"op":9,"name":"delay","args":[7]},{"op":52,"name":"actor_action","args":[49,6]},{"op":20,"name":"dialog","args":["&李渊\n不瞒老千岁，\n的确听到了一些风传…\n&伍建章\n哦？怎样？\n&李渊\n好像是…东宫出事了。\n&伍建章\n东、东宫？东宫怎么了？\n&李渊\n听说太子他…"]},{"op":48,"name":"actor_appear","args":[941,94,54,3,0]},{"op":50,"name":"actor_move","args":[65535,941,0,86,54,3]},{"op":51,"name":"actor_face","args":[49,0,0]},{"op":51,"name":"actor_face","args":[940,0,0]},{"op":20,"name":"dialog","args":["&张衡\n陛下驾到。"]},{"op":50,"name":"actor_move","args":[65535,941,0,42,54,0]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[65535,941,0,42,46,1]},{"op":48,"name":"actor_appear","args":[962,94,54,3,0]},{"op":50,"name":"actor_move","args":[65535,962,0,88,54,3]},{"op":48,"name":"actor_appear","args":[51,94,58,3,0]},{"op":48,"name":"actor_appear","args":[40,94,50,3,0]},{"op":50,"name":"actor_move","args":[65535,962,0,38,54,3]},{"op":50,"name":"actor_move","args":[65535,51,0,44,58,3]},{"op":50,"name":"actor_move","args":[65535,40,0,44,50,3]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[65535,962,0,26,54,1]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[65535,51,0,26,62,1]},{"op":50,"name":"actor_move","args":[65535,40,0,26,46,1]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&杨坚\n朕深夜传召诸位爱卿，\n是有一件重要的事情要宣布。\n张衡，宣旨。\n&张衡\n遵旨。"]},{"op":50,"name":"actor_move","args":[65535,941,0,42,54,1]},{"op":52,"name":"actor_action","args":[941,16]},{"op":20,"name":"dialog","args":["&张衡\n太子勇忤逆不孝，私自\n建宫苑，蓄马匹，暗施巫蛊，\n诅咒天子，图谋篡位。\n&张衡\n寡人失德，竟使如此伦常败坏，\n丧心病狂之子安居东宫二十年之久，\n实为大隋之不幸，万民之不幸。\n&张衡\n今命拘拿逆子勇，废其太子\n之位，待问明详情后再作发落。\n特此诏告群臣。钦此。\n&李渊\n（什、什么！\n废掉太子！？）\n&张衡\n越王接旨。"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[100,6]},{"op":20,"name":"dialog","args":["&杨素\n臣在。"]},{"op":50,"name":"actor_move","args":[65535,100,0,48,54,1]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[65535,100,0,52,54,3]},{"op":9,"name":"delay","args":[0]},{"op":52,"name":"actor_action","args":[100,11]},{"op":20,"name":"dialog","args":["&张衡\n着越王审理太子谋逆一案。\n&杨素\n臣领旨。\n&伍建章\n（竟把这案子交给越王审理，老杨素\n是晋王一党，一直想把太子搞掉，让他\n来办这案子，还有太子的活路么…）"]},{"op":52,"name":"actor_action","args":[941,0]},{"op":50,"name":"actor_move","args":[65535,100,0,48,54,0]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[65535,100,0,48,42,2]},{"op":50,"name":"actor_move","args":[65535,941,0,42,46,1]},{"op":52,"name":"actor_action","args":[940,3]},{"op":20,"name":"dialog","args":["&伍建章\n陛下且慢！"]},{"op":50,"name":"actor_move","args":[65535,940,0,48,54,3]},{"op":52,"name":"actor_action","args":[940,2]},{"op":20,"name":"dialog","args":["&伍建章\n太子是国家储君，\n江山社稷的命脉所系，\n岂可因几句流言而轻易废黜！"]},{"op":52,"name":"actor_action","args":[940,0]},{"op":20,"name":"dialog","args":["&杨坚\n哼，照伍爱卿这样说，\n朕这个当朝天子，\n还废不得他国家储君么？"]},{"op":52,"name":"actor_action","args":[940,3]},{"op":20,"name":"dialog","args":["&伍建章\n老臣不是这个意思。老臣只是认为，\n太子虽有声色玩好的小过，\n谋位篡权之事却是万万做不出来的。"]},{"op":52,"name":"actor_action","args":[940,0]},{"op":20,"name":"dialog","args":["&伍建章\n老臣敢拿身家性命替太子担保。\n请陛下将此案交给老臣办理，不需\n一个月，老臣定给陛下拿出一个说法。\n&杨坚\n哦…这样嘛…"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&宇文化及\n哼哼哼哼…"]},{"op":52,"name":"actor_action","args":[940,2]},{"op":20,"name":"dialog","args":["&伍建章\n大胆！竟敢在陛下背后发笑！"]},{"op":52,"name":"actor_action","args":[940,0]},{"op":20,"name":"dialog","args":["&宇文化及\n我笑老千岁真不愧是太子太傅啊。\n&宇文化及\n如此重大的案子也敢担保一个月\n之内告破，莫非您老早已准备好了\n替太子开脱的证据？"]},{"op":52,"name":"actor_action","args":[940,2]},{"op":20,"name":"dialog","args":["&伍建章\n你！你说什么！？\n&李渊\n陛下。"]},{"op":51,"name":"actor_face","args":[940,0,1]},{"op":50,"name":"actor_move","args":[65535,49,0,54,54,3]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[65535,940,0,48,48,2]},{"op":50,"name":"actor_move","args":[65535,49,0,48,54,3]},{"op":52,"name":"actor_action","args":[49,6]},{"op":20,"name":"dialog","args":["&李渊\n陛下，臣也以为太子绝不可废。\n&杨坚\n哦？李渊，\n你们师生两个可真是同声共鸣啊。\n你也想审理太子谋逆一案么？\n&李渊\n臣不敢。臣只是认为，太子居东宫\n二十年，有德无过。如今罪无实据\n而先行废黜，恐失天下人望。\n&李渊\n而且，请陛下恕臣直言：陛下虽然龙体\n健旺，但毕竟仁寿已高。此时因废太子\n而使天下失去储君，实非保国安民之道。"]},{"op":51,"name":"actor_face","args":[940,0,3]},{"op":52,"name":"actor_action","args":[49,0]},{"op":52,"name":"actor_action","args":[51,2]},{"op":20,"name":"dialog","args":["&杨广\n大胆李渊！竟敢这样对父王讲话！"]},{"op":52,"name":"actor_action","args":[51,0]},{"op":51,"name":"actor_face","args":[962,0,2]},{"op":20,"name":"dialog","args":["&杨坚\n广儿，李渊他说得很有道理。\n为君者，要懂得坚持，\n也要学会听取意见。"]},{"op":51,"name":"actor_face","args":[51,6,0]},{"op":20,"name":"dialog","args":["&杨广\n是、是，儿臣记住了…"]},{"op":51,"name":"actor_face","args":[51,0,1]},{"op":51,"name":"actor_face","args":[962,0,1]},{"op":20,"name":"dialog","args":["&杨坚\n李渊你说得不错。\n朕是不会让人民失去储君的。\n&宇文化及\n！\n&杨广\n（糟了…）"]},{"op":52,"name":"actor_action","args":[49,6]},{"op":20,"name":"dialog","args":["&李渊\n陛下圣明。"]},{"op":52,"name":"actor_action","args":[49,0]},{"op":20,"name":"dialog","args":["&杨坚\n宇文化及。"]},{"op":51,"name":"actor_face","args":[40,6,2]},{"op":20,"name":"dialog","args":["&宇文化及\n臣在。\n&杨坚\n替朕拟诏。\n朕已决定，立晋王广为太子。\n即日移居东宫。"]},{"op":20,"name":"dialog","args":["&杨广\n（啊？！）\n&伍建章\n什、什么！？\n&宇文化及\n（竟然这么快…）"]},{"op":20,"name":"dialog","args":["&杨坚\n怎么？没听到朕的话么？\n速速拟诏。\n&宇文化及\n哦，是！臣遵旨！"]},{"op":51,"name":"actor_face","args":[40,0,1]},{"op":20,"name":"dialog","args":["&杨广\n（终于当上太子了！\n我不是在做梦吧？…）"]},{"op":52,"name":"actor_action","args":[49,6]},{"op":20,"name":"dialog","args":["&李渊\n陛、陛下！废立之事未可轻率啊！"]},{"op":52,"name":"actor_action","args":[49,0]},{"op":20,"name":"dialog","args":["&杨坚\n无须多言。广儿自幼聪颖，才干\n远胜于你们的那位旧太子，朕意属\n他已经很久，今天就这么定了。\n&李渊\n…"]},{"op":52,"name":"actor_action","args":[940,2]},{"op":20,"name":"dialog","args":["&伍建章\n陛下！请三思！"]},{"op":52,"name":"actor_action","args":[940,0]},{"op":20,"name":"dialog","args":["&杨坚\n朕意已决，\n东宫的事情就这样处理。\n谁再多言按抗旨论处！\n&伍建章\n唔…"]},{"op":51,"name":"actor_face","args":[962,0,0]},{"op":20,"name":"dialog","args":["&杨坚\n没有其它事情的话，\n各位爱卿可以回府安歇了。\n朕也困了，想要休息。\n&李渊\n…"]},{"op":52,"name":"actor_action","args":[49,6]},{"op":20,"name":"dialog","args":["&李渊\n陛下。"]},{"op":51,"name":"actor_face","args":[962,0,1]},{"op":20,"name":"dialog","args":["&杨坚\n怎么，真有人敢抗旨么？\n&李渊\n臣不敢。臣只是想向陛下告假。\n臣请求辞去爵位和官职，返回故里。"]},{"op":51,"name":"actor_face","args":[940,0,2]},{"op":20,"name":"dialog","args":["&伍建章\n李大人你…\n&杨坚\n李渊啊，你是在跟朕耍脾气么？\n&李渊\n微臣绝不敢对陛下不满。然臣身为\n前任太子的礼法导师，前任太子\n犯下如此大罪，臣也难辞其咎。\n&李渊\n求陛下念在臣多年来为社稷尽忠，\n饶臣一命，准臣返乡思过终老。"]},{"op":52,"name":"actor_action","args":[49,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&杨坚\n呵呵呵呵，朕并不想怪罪你。\n不过既然李爱卿自己提出要去思过，\n朕就成全了你。李渊听旨。"]},{"op":52,"name":"actor_action","args":[49,11]},{"op":20,"name":"dialog","args":["&李渊\n臣接旨。\n&杨坚\n唐公李渊，身为国戚，兼太子\n导师，不思进取，玩忽职守，\n致使皇胄不学，败纲乱政。\n&杨坚\n念其多年来有功于朝廷，贬为太原侯，\n回乡养老，终生不得返京。着三日内\n离开京城，速速回家收拾行李去罢。\n&李渊\n臣领旨谢恩。"]},{"op":52,"name":"actor_action","args":[49,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[49,6]},{"op":9,"name":"delay","args":[9]},{"op":51,"name":"actor_face","args":[49,6,0]},{"op":9,"name":"delay","args":[9]},{"op":52,"name":"actor_action","args":[49,0]},{"op":9,"name":"delay","args":[9]},{"op":51,"name":"actor_face","args":[940,0,1]},{"op":50,"name":"actor_move","args":[65535,49,0,96,54,1]},{"op":52,"name":"actor_action","args":[49,15]},{"op":20,"name":"dialog","args":["&伍建章\n（李大人…）\n&杨广\n（哼，这厮溜得倒挺快…）"]},{"op":9,"name":"delay","args":[9]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":9,"name":"delay","args":[10]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":9031,"sections":[{"index":0,"offset":9033,"title":"知安危唐公离西京","conditions":[{"op":2,"name":"comment","args":["知安危唐公离西京"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[1]},{"op":24,"name":"title_text","args":[""]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":39,"name":"change_scene","args":[0,3,65535,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":44,"name":"caption","args":["隋文帝次子晋王杨广表面谦恭仁厚，",1,0,0]},{"op":9,"name":"delay","args":[7]},{"op":44,"name":"caption","args":["内心阴险歹毒。",1,0,0]},{"op":9,"name":"delay","args":[7]},{"op":44,"name":"caption","args":["在越王杨素、",1,0,0]},{"op":44,"name":"caption","args":["近臣宇文化及等人的支持下，设计陷害太子杨勇，",1,1,0]},{"op":9,"name":"delay","args":[7]},{"op":44,"name":"caption","args":["夺取了王储之位。",1,0,1]},{"op":29,"name":"fade_in","args":[]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":39,"name":"change_scene","args":[0,4,65535,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":44,"name":"caption","args":["杨广入主东宫后，在朝中大力培植自己的势力，",1,0,0]},{"op":9,"name":"delay","args":[7]},{"op":44,"name":"caption","args":["众多旧太子派的大臣纷纷倒台，被迫离京。",1,1,1]},{"op":29,"name":"fade_in","args":[]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":39,"name":"change_scene","args":[0,6,65535,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":44,"name":"caption","args":["这些大臣中也不乏一些才能卓著，",1,0,0]},{"op":9,"name":"delay","args":[7]},{"op":44,"name":"caption","args":["胸怀大志的英杰。",1,0,1]},{"op":44,"name":"caption","args":["杨氏王朝的外戚，杨勇的老师——",1,1,0]},{"op":9,"name":"delay","args":[7]},{"op":44,"name":"caption","args":["唐公李渊就是其中之一。",1,0,1]},{"op":9,"name":"delay","args":[7]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":9,"name":"delay","args":[10]},{"op":39,"name":"change_scene","args":[2,65535,65535,240,65535]},{"op":48,"name":"actor_appear","args":[49,68,57,0,1]},{"op":24,"name":"title_text","args":["唐公辞京"]},{"op":36,"name":"play_sound","args":[26]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[202,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["唐公府  内宅"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&李渊\n太子…"]},{"op":52,"name":"actor_action","args":[49,9]},{"op":20,"name":"dialog","args":["&李渊\n李渊无能，\n保护不了您…\n&李世民\n父亲。"]},{"op":52,"name":"actor_action","args":[49,1]},{"op":20,"name":"dialog","args":["&李渊\n世民么？进来吧。"]},{"op":48,"name":"actor_appear","args":[67,55,29,2,0]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&李世民\n父亲，行装已经打点好了。\n我们什么时候动身？"]},{"op":52,"name":"actor_action","args":[49,0]},{"op":20,"name":"dialog","args":["&李渊\n哦，现在马上就走。"]},{"op":50,"name":"actor_move","args":[65535,67,0,55,49,1]},{"op":52,"name":"actor_action","args":[67,0]},{"op":20,"name":"dialog","args":["&李世民\n可是父亲，现在是晚上啊。"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[49,0,3]},{"op":20,"name":"dialog","args":["&李渊\n京城已经不是我们的活命之所，\n我们多在京里呆一刻，就多一分\n性命之忧。这一点你都看不明白么？"]},{"op":51,"name":"actor_face","args":[67,0,2]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&李世民\n父亲，我不太明白，多年来\n你一直教我们兄弟韬光养晦，\n不可在权争里显露头脸。\n&李世民\n可是在昨晚的会议上\n您为何要站出来\n明着与晋王作对呢？"]},{"op":50,"name":"actor_move","args":[65535,49,0,55,57,3]},{"op":52,"name":"actor_action","args":[49,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&李渊\n唉…世民啊，\n政治就像赌博，\n朝廷就如同一个赌场。\n&李渊\n我李家是当朝外戚，在这个赌场里，就\n好比腰缠万贯的富家子，即使身上的钱\n输光了，也还可以回家去拿来接着赌。\n&李渊\n很多时候，如果输上一大笔银子\n而可以换来满堂的喝彩，\n那也是值得的。因为钱我们输得起。\n&李渊\n但是，有一些东西，\n即使是富人家也输不起。"]},{"op":51,"name":"actor_face","args":[49,0,0]},{"op":20,"name":"dialog","args":["&李渊\n那就是房子和地。\n&李世民\n父亲的话，孩儿明白了。\n太子杨勇就是我们的房子和地。"]},{"op":51,"name":"actor_face","args":[67,0,1]},{"op":50,"name":"actor_move","args":[65535,49,0,68,57,1]},{"op":52,"name":"actor_action","args":[49,0]},{"op":20,"name":"dialog","args":["&李渊\n是啊…多年来，\n我们把宝全都押在太子的头上。\n朝里朝外都知道我们是太子的党众。\n&李渊\n晋王杨广窥伺储位已久，被我多方阻止，\n早就恨我入骨。此人年纪虽轻，但当真心\n狠手辣。一旦坐了东宫之位，必然害我。\n&李渊\n因此我孤注一掷，\n力图当场阻止万岁的决定。\n奈何…唉…"]},{"op":52,"name":"actor_action","args":[67,6]},{"op":20,"name":"dialog","args":["&李世民\n父亲的心思，孩儿已经明白了。\n但孩儿还是认为不可连夜离京。"]},{"op":52,"name":"actor_action","args":[67,0]},{"op":51,"name":"actor_face","args":[49,0,3]},{"op":20,"name":"dialog","args":["&李渊\n哦？为什么？"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[67,0,0]},{"op":20,"name":"dialog","args":["&李世民\n杨广狡诈，他身边的党羽宇文化及\n等人也个个阴狠。现在夜黑风高，\n我们此时离京，只怕要遭他们的算计。\n&李世民\n不若明日天亮后堂而皇之大队出京，\n量他们也没有胆量\n在光天化日之下加害我们一家。"]},{"op":51,"name":"actor_face","args":[67,0,1]},{"op":52,"name":"actor_action","args":[49,3]},{"op":20,"name":"dialog","args":["&李渊\n我儿所言极是！\n为父心绪烦乱，\n几乎误算了此招。"]},{"op":52,"name":"actor_action","args":[49,0]},{"op":50,"name":"actor_move","args":[65535,49,0,55,57,0]},{"op":52,"name":"actor_action","args":[49,0]},{"op":51,"name":"actor_face","args":[67,0,2]},{"op":20,"name":"dialog","args":["&李渊\n世民，你能临危不乱，\n是大将之才啊。"]},{"op":52,"name":"actor_action","args":[67,6]},{"op":20,"name":"dialog","args":["&李世民\n父亲过奖了。\n那孩儿这就去通知大哥和三弟，\n让他们早些休息，明日一早出发。"]},{"op":52,"name":"actor_action","args":[67,0]},{"op":20,"name":"dialog","args":["&李渊\n好。芙蓉呢？\n&李世民\n姐姐正在母亲房中陪母亲说话。\n&李渊\n你母亲怀胎十月，即将临盆，\n现在受不得惊吓，还是叫\n芙蓉早些回自己房里安歇吧。"]},{"op":51,"name":"actor_face","args":[49,0,1]},{"op":20,"name":"dialog","args":["&李渊\n唉，天不佑李渊，害得全家老小随我\n一起颠沛流离。旅途颠簸，这次恐怕\n要苦了你那身怀六甲的母亲了…"]},{"op":9,"name":"delay","args":[9]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[202,255]},{"op":36,"name":"play_sound","args":[255]},{"op":9,"name":"delay","args":[10]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":12214,"sections":[{"index":0,"offset":12216,"title":"窄量奸党谋贤臣","conditions":[{"op":2,"name":"comment","args":["窄量奸党谋贤臣"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,28,65535]},{"op":36,"name":"play_sound","args":[15]},{"op":48,"name":"actor_appear","args":[49,60,56,2,0]},{"op":48,"name":"actor_appear","args":[940,60,68,0,0]},{"op":48,"name":"actor_appear","args":[39,56,48,2,0]},{"op":48,"name":"actor_appear","args":[67,64,48,2,0]},{"op":48,"name":"actor_appear","args":[64,64,38,2,0]},{"op":48,"name":"actor_appear","args":[1015,60,38,2,0]},{"op":48,"name":"actor_appear","args":[1019,56,38,2,0]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["唐公府  门前"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[49,6]},{"op":20,"name":"dialog","args":["&李渊\n老千岁不必远送。\n晚生就此告辞了。\n&李渊\n他日老千岁若能得暇到太原作客，\n一定要事先告知晚生，\n也好让晚生有机会尽地主之谊。"]},{"op":52,"name":"actor_action","args":[49,0]},{"op":20,"name":"dialog","args":["&伍建章\n那是一定。\n李大人，你这一走，老夫在京中\n又少了一个可以交心之人啊。"]},{"op":52,"name":"actor_action","args":[49,6]},{"op":20,"name":"dialog","args":["&李渊\n老千岁无须伤感，\n自己多多保重才是。\n晚生就此告辞了。"]},{"op":52,"name":"actor_action","args":[940,6]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[49,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[49,0,0]},{"op":51,"name":"actor_face","args":[39,0,0]},{"op":51,"name":"actor_face","args":[67,0,0]},{"op":51,"name":"actor_face","args":[64,0,0]},{"op":51,"name":"actor_face","args":[1019,0,0]},{"op":51,"name":"actor_face","args":[1015,0,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,64,0,64,12,0]},{"op":50,"name":"actor_move","args":[65535,1019,0,56,12,0]},{"op":50,"name":"actor_move","args":[65535,1015,0,60,12,0]},{"op":50,"name":"actor_move","args":[65535,39,0,56,12,0]},{"op":50,"name":"actor_move","args":[65535,67,0,64,12,0]},{"op":50,"name":"actor_move","args":[65535,49,0,60,12,0]},{"op":52,"name":"actor_action","args":[64,15]},{"op":52,"name":"actor_action","args":[1019,15]},{"op":52,"name":"actor_action","args":[1015,15]},{"op":52,"name":"actor_action","args":[39,15]},{"op":52,"name":"actor_action","args":[67,15]},{"op":52,"name":"actor_action","args":[49,15]},{"op":52,"name":"actor_action","args":[940,0]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&伍建章\n唉…"]},{"op":50,"name":"actor_move","args":[65535,940,0,82,68,1]},{"op":52,"name":"actor_action","args":[940,15]},{"op":9,"name":"delay","args":[5]},{"op":48,"name":"actor_appear","args":[51,54,84,0,0]},{"op":48,"name":"actor_appear","args":[40,56,92,0,0]},{"op":50,"name":"actor_move","args":[65535,51,0,64,80,0]},{"op":50,"name":"actor_move","args":[65535,40,0,56,84,0]},{"op":9,"name":"delay","args":[0]},{"op":9,"name":"delay","args":[7]},{"op":52,"name":"actor_action","args":[51,2]},{"op":20,"name":"dialog","args":["&杨广\n哼！李渊这厮和伍老儿一起\n在父王面前说我坏话，害得我\n险些坐不上东宫的位子。\n&杨广\n本打算好好对付他们两个，\n想不到却让这厮先跑了！"]},{"op":52,"name":"actor_action","args":[51,0]},{"op":50,"name":"actor_move","args":[65535,40,0,56,80,0]},{"op":20,"name":"dialog","args":["&宇文化及\n呵呵，太子何必和一个\n已经永远回不了京城的人生气？"]},{"op":51,"name":"actor_face","args":[51,2,3]},{"op":20,"name":"dialog","args":["&杨广\n我们苦心经营了十几年的大事差点就\n被他折腾毁了！难道你不生气么？！"]},{"op":52,"name":"actor_action","args":[51,0]},{"op":20,"name":"dialog","args":["&宇文化及\n呵呵呵，老臣从不跟死人生气…\n&杨广\n哎？你说什么？"]},{"op":51,"name":"actor_face","args":[40,6,1]},{"op":20,"name":"dialog","args":["&宇文化及\n看来太子是忘了。老臣曾向太子\n承诺过，太子看着碍眼的人，\n老臣绝不会让他留在世上。"]},{"op":52,"name":"actor_action","args":[40,0]},{"op":52,"name":"actor_action","args":[51,3]},{"op":20,"name":"dialog","args":["&杨广\n哦！这么说，你已经有了\n安排喽？哈哈哈哈，爱卿\n真不愧是本宫的左膀右臂啊！"]},{"op":52,"name":"actor_action","args":[51,0]},{"op":52,"name":"actor_action","args":[40,6]},{"op":20,"name":"dialog","args":["&宇文化及\n殿下请放心，十日之内，\n您就会看到李渊的人头。"]},{"op":52,"name":"actor_action","args":[40,0]},{"op":52,"name":"actor_action","args":[51,3]},{"op":20,"name":"dialog","args":["&杨广\n哈哈哈哈，好！好！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[51,0,2]},{"op":20,"name":"dialog","args":["&杨广\n心情突然变好啦！\n走，我们回宫！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[40,0,2]},{"op":50,"name":"actor_move","args":[65535,51,0,64,96,2]},{"op":52,"name":"actor_action","args":[51,15]},{"op":9,"name":"delay","args":[7]},{"op":52,"name":"actor_action","args":[40,12]},{"op":20,"name":"dialog","args":["&宇文化及\n（哼哼，这个沉不住气的小子…）"]},{"op":9,"name":"delay","args":[7]},{"op":51,"name":"actor_face","args":[40,0,1]},{"op":20,"name":"dialog","args":["&宇文化及\n叔谋啊，来了这么久干嘛一直\n躲在一边啊？山东那边的事办\n砸了，就再也不好意思见我了么？"]},{"op":48,"name":"actor_appear","args":[59,82,68,3,0]},{"op":52,"name":"actor_action","args":[59,0]},{"op":50,"name":"actor_move","args":[65535,59,0,56,70,2]},{"op":51,"name":"actor_face","args":[40,12,0]},{"op":52,"name":"actor_action","args":[59,6]},{"op":20,"name":"dialog","args":["&麻叔谋\n孩儿办事不力，未能抢在杨老儿\n之前攻入牧龙谷，抢到地下迷城图，\n请义父大人恕罪。"]},{"op":52,"name":"actor_action","args":[59,0]},{"op":51,"name":"actor_face","args":[40,12,1]},{"op":20,"name":"dialog","args":["&宇文化及\n呵呵，幸好不碍事。我已打听过了，\n杨老儿的人虽然攻进了山谷，却也没\n找到那张图。我们只是打了个平手。\n&麻叔谋\n义父大人，那张图真的那么重要么？\n&宇文化及\n那图关乎一批南陈遗留下来的宝藏，\n我也是花了大价钱才从杨老儿的亲\n信那里得到的这个情报。"]},{"op":51,"name":"actor_face","args":[40,12,0]},{"op":20,"name":"dialog","args":["&宇文化及\n老皇上沉湎女色，日益衰弱，\n新太子对为父言听计从。\n&宇文化及\n在这种情况下，这笔宝藏对为父来说\n意义有多么重大，你是不会明白的，\n我的傻小子。哈哈哈哈…"]},{"op":52,"name":"actor_action","args":[59,6]},{"op":20,"name":"dialog","args":["&麻叔谋\n可是…孩儿不明白，\n我们没有得到地图，义父您\n为何还是这么高兴？"]},{"op":52,"name":"actor_action","args":[59,0]},{"op":51,"name":"actor_face","args":[40,12,1]},{"op":20,"name":"dialog","args":["&宇文化及\n呵呵呵，如今朝中能够像\n为父一样呼风唤雨的人已经不多了。\n&宇文化及\n只要这笔宝藏没落到\n他们手里，我们就没什么\n可慌的。明白么？"]},{"op":52,"name":"actor_action","args":[59,6]},{"op":20,"name":"dialog","args":["&麻叔谋\n那，孩儿还有一件事情想要求告义父。"]},{"op":52,"name":"actor_action","args":[59,0]},{"op":20,"name":"dialog","args":["&宇文化及\n什么事？讲。\n&麻叔谋\n这次在牧龙谷，孩儿为了帮您抢图，\n违背了杨老儿的军令，提前攻山。\n&麻叔谋\n由此，杨老儿已经知道我和他\n不是一条心，今后可能不再重用孩儿，\n说不定还会加害于我…\n&宇文化及\n那是不会的。我和他表面上一向很\n要好，而且又同为太子办事，他即使\n知道你是我的人，也不至于就宰了你。\n&麻叔谋\n可是孩儿身为武将，一旦\n得不到上司重用，立不了军功，\n今后的前程恐怕…"]},{"op":51,"name":"actor_face","args":[40,12,0]},{"op":20,"name":"dialog","args":["&宇文化及\n军功？"]},{"op":52,"name":"actor_action","args":[40,3]},{"op":20,"name":"dialog","args":["&宇文化及\n哈哈哈哈，在太平盛世里还有谁\n看你的军功！"]},{"op":52,"name":"actor_action","args":[40,0]},{"op":51,"name":"actor_face","args":[40,0,2]},{"op":20,"name":"dialog","args":["&宇文化及\n傻小子，记住，这是权谋术数的时代。\n只要你继续跟着为父走，为父会让你\n看到什么才是真正的丰功伟业！"]},{"op":52,"name":"actor_action","args":[59,6]},{"op":20,"name":"dialog","args":["&麻叔谋\n是、是…"]},{"op":52,"name":"actor_action","args":[40,3]},{"op":20,"name":"dialog","args":["&宇文化及\n哈哈哈哈哈…"]},{"op":9,"name":"delay","args":[7]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":9,"name":"delay","args":[10]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":4,"offset":16116,"sections":[{"index":0,"offset":16118,"title":"粗心英雄遇义士","conditions":[{"op":2,"name":"comment","args":["粗心英雄遇义士"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,67,65535]},{"op":48,"name":"actor_appear","args":[0,50,96,0,0]},{"op":48,"name":"actor_appear","args":[73,48,4,2,0]},{"op":48,"name":"actor_appear","args":[8,50,4,2,0]},{"op":36,"name":"play_sound","args":[17]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[201,0]},{"op":9,"name":"delay","args":[3]},{"op":24,"name":"title_text","args":["救难临潼山"]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["潞州郊外  临潼山"]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,0,0,50,82,0]},{"op":20,"name":"dialog","args":["&管毅\n（再往前走就是潞州地界了。\n不知定方到了没有…）"]},{"op":50,"name":"actor_move","args":[65535,0,0,50,43,0]},{"op":50,"name":"actor_move","args":[65535,73,0,48,43,2]},{"op":35,"name":"play_music","args":[201,255]},{"op":9,"name":"delay","args":[1]},{"op":35,"name":"play_music","args":[28,1]},{"op":20,"name":"dialog","args":["&周治\n哎哟！"]},{"op":35,"name":"play_music","args":[201,0]},{"op":51,"name":"actor_face","args":[0,0,3]},{"op":50,"name":"actor_move","args":[65535,73,0,40,43,1]},{"op":52,"name":"actor_action","args":[73,0]},{"op":20,"name":"dialog","args":["&周治\n走路留神啊！想撞死人不成！"]},{"op":52,"name":"actor_action","args":[73,0]},{"op":52,"name":"actor_action","args":[0,6]},{"op":20,"name":"dialog","args":["&管毅\n哦，真是对不起。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":51,"name":"actor_face","args":[73,0,2]},{"op":20,"name":"dialog","args":["&周治\n哼！瞎了眼的东西…"]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":50,"name":"actor_move","args":[65535,73,0,40,96,2]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&管毅\n（山西人真凶…\n明明是他自己撞过来的…）"]},{"op":50,"name":"actor_move","args":[65535,0,0,50,39,0]},{"op":50,"name":"actor_move","args":[65535,8,0,50,30,2]},{"op":52,"name":"actor_action","args":[8,6]},{"op":20,"name":"dialog","args":["&秦琼\n请问这位小兄弟，\n刚才有没有看到一个扎黄色头巾\n的年轻人从此经过？"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[8,0]},{"op":20,"name":"dialog","args":["&管毅\n刚刚确有一个扎头巾的小伙子，\n与我撞了个满怀，然后向南去了。"]},{"op":9,"name":"delay","args":[1]},{"op":20,"name":"dialog","args":["&秦琼\n他撞了你？\n小兄弟，快检查一下自己身上，\n看看财物有没有丢失？\n&管毅\n哎？"]},{"op":51,"name":"actor_face","args":[0,6,3]},{"op":9,"name":"delay","args":[7]},{"op":51,"name":"actor_face","args":[0,3,0]},{"op":36,"name":"play_sound","args":[61]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["头像变化（管毅惊·新）"]},"end":53},{"op":120,"name":"data_transfer","args":[0,0,0,1]},{"op":119,"name":"int_var_op","args":[2,0,2,0,1]},{"op":120,"name":"data_transfer","args":[0,1,0,1]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&管毅\n啊呀！我的钱包！"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["头像变化（管毅正常·新）"]},"end":59},{"op":120,"name":"data_transfer","args":[0,0,0,1]},{"op":119,"name":"int_var_op","args":[2,0,2,0,0]},{"op":120,"name":"data_transfer","args":[0,1,0,1]},{"op":0,"name":"end","args":[]},{"op":52,"name":"actor_action","args":[0,0]},{"op":51,"name":"actor_face","args":[8,2,1]},{"op":20,"name":"dialog","args":["&秦琼\n嘿！果然是这个恶贼！\n可惜又让他给跑了！\n&管毅\n这位大哥，\n我的钱包是被那个人偷了么？"]},{"op":51,"name":"actor_face","args":[8,0,2]},{"op":20,"name":"dialog","args":["&秦琼\n小兄弟，听你的口音也不是山西人，\n你是第一次出远门吧？\n&管毅\n（想不到我刚刚出山就遭遇了\n盗贼，看来所谓太平盛世\n也是处处凶险啊…）\n&管毅\n（这大汉看起来十分面善，\n不像是朝廷的爪牙，我就\n不必刻意向他隐瞒什么了…）"]},{"op":52,"name":"actor_action","args":[0,6]},{"op":20,"name":"dialog","args":["&管毅\n在下姓管名毅字德昭。\n随恩师一同在山东卧虎山中隐居，\n十三年来一直不曾出山。\n&管毅\n此次奉师命到潞州访友，哪知盗贼如此\n猖狂。在下所带的盘缠不多，如今被\n盗，真不知如何是好。万望大哥相助。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":52,"name":"actor_action","args":[8,6]},{"op":20,"name":"dialog","args":["&秦琼\n原来贤弟也是山东人。\n在下姓秦名琼字叔宝，\n是山东历城县的捕快。"]},{"op":52,"name":"actor_action","args":[8,0]},{"op":20,"name":"dialog","args":["&秦琼\n被盗之事，贤弟不必着急，\n秦某一定捉住那恶贼，还你财物。"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&管毅\n哦，想不到在这里竟能遇到同乡！"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&管毅\n刚才听秦兄所说，\n似乎知道那盗贼的根底，\n不知这其中可有什么渊源？"]},{"op":51,"name":"actor_face","args":[8,0,1]},{"op":20,"name":"dialog","args":["&秦琼\n唉，说来惭愧。一个多月之前，\n山西大盗「小母鸡」周治流窜到\n济南作案，我奉命将其捉拿归案。\n&秦琼\n哪知在遣送他回潞州的途中\n不慎被他走脱，继续四处流窜作案。\n&秦琼\n秦某追踪他已有数日，奈何在山西\n人生地不熟，屡屡被他溜走。"]},{"op":51,"name":"actor_face","args":[8,6,2]},{"op":20,"name":"dialog","args":["&秦琼\n这事说起来也是秦某失职之过。\n时不我待，秦某还要去追那恶贼，\n就此别过。"]},{"op":52,"name":"actor_action","args":[8,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,8,0,50,36,2]},{"op":52,"name":"actor_action","args":[8,5]},{"op":20,"name":"dialog","args":["&秦琼\n我这里有一些银两，\n贤弟可拿去暂作花销。"]},{"op":50,"name":"actor_move","args":[65535,8,0,50,30,2]},{"op":52,"name":"actor_action","args":[8,0]},{"op":20,"name":"dialog","args":["&秦琼\n若是贤弟信得过秦某，可到\n潞州官衙附近找家客栈住下，\n每日到潞州官衙门前等候。\n&秦琼\n待我擒了那贼，\n自会押他去衙门归案，\n届时一并把兄弟的财物奉还。"]},{"op":52,"name":"actor_action","args":[8,6]},{"op":20,"name":"dialog","args":["&秦琼\n后会有期。"]},{"op":51,"name":"actor_face","args":[0,0,3]},{"op":50,"name":"actor_move","args":[65535,8,0,42,30,2]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[65535,8,0,42,60,2]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":20,"name":"dialog","args":["&管毅\n（如此侠义心肠，真是一条好汉…）"]},{"op":9,"name":"delay","args":[3]},{"op":36,"name":"play_sound","args":[11]},{"op":1,"name":"if","args":[],"cond":{"op":18,"name":"choice","args":["与秦叔宝同往擒贼\n到潞州官衙附近等待",65535]},"end":155},{"op":1,"name":"if","args":[],"cond":{"op":19,"name":"test_choice","args":[1]},"end":119},{"op":36,"name":"play_sound","args":[45]},{"op":58,"name":"set_resource","args":[2,2,2]},{"op":119,"name":"int_var_op","args":[2,1006,0,0,1]},{"op":35,"name":"play_music","args":[201,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,3]},{"op":51,"name":"actor_face","args":[8,0,0]},{"op":20,"name":"dialog","args":["&管毅\n秦兄请留步。"]},{"op":50,"name":"actor_move","args":[65535,0,0,50,60,2]},{"op":51,"name":"actor_face","args":[8,0,1]},{"op":51,"name":"actor_face","args":[0,0,3]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,6]},{"op":20,"name":"dialog","args":["&管毅\n小弟虽然久居深山，却也听恩师讲过\n那些人情冷暖。秦兄与小弟萍水相逢，\n便肯解囊相助，真乃慷慨义士。\n&管毅\n不瞒秦兄讲，小弟自幼承名师指点枪棒，\n也敢自负武艺不俗。那小偷既能从我身\n上盗走钱包，想必的确有些凶险的手段。\n&管毅\n秦兄如此仗义，\n小弟又岂能让你独自涉险，\n愿随兄长同去捉那恶贼。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":52,"name":"actor_action","args":[8,3]},{"op":20,"name":"dialog","args":["&秦琼\n哦，如此甚好！我观管贤弟\n气色便知你是个练家子，此次\n能得贤弟相助，何愁擒不住那恶贼！"]},{"op":52,"name":"actor_action","args":[8,0]},{"op":20,"name":"dialog","args":["&秦琼\n只是那恶贼本来就是出自山西，\n在潞州附近多有巢穴，\n他此去向南，必是去投楂树岗。\n&秦琼\n那里地势险恶，近日更是听说出了\n一批响马，我们此去可谓十分危险，\n贤弟可要想清楚了。\n&管毅\n秦兄放心，我们快走吧。\n&秦琼\n好。"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":19,"name":"test_choice","args":[2]},"end":154},{"op":36,"name":"play_sound","args":[45]},{"op":58,"name":"set_resource","args":[2,1,3]},{"op":119,"name":"int_var_op","args":[2,1006,1,0,1]},{"op":35,"name":"play_music","args":[201,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&管毅\n…"]},{"op":9,"name":"delay","args":[7]},{"op":52,"name":"actor_action","args":[0,3]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["头像变化（管毅惊·新）"]},"end":133},{"op":120,"name":"data_transfer","args":[0,0,0,1]},{"op":119,"name":"int_var_op","args":[2,0,2,0,1]},{"op":120,"name":"data_transfer","args":[0,1,0,1]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&管毅\n（唉呀！不好！\n地下迷城图的碎片还装在钱袋里，\n那是万万不能落入他人手中的！）"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["头像变化（管毅正常·新）"]},"end":139},{"op":120,"name":"data_transfer","args":[0,0,0,1]},{"op":119,"name":"int_var_op","args":[2,0,2,0,0]},{"op":120,"name":"data_transfer","args":[0,1,0,1]},{"op":0,"name":"end","args":[]},{"op":52,"name":"actor_action","args":[0,0]},{"op":51,"name":"actor_face","args":[8,0,0]},{"op":20,"name":"dialog","args":["&管毅\n秦兄留步！"]},{"op":50,"name":"actor_move","args":[65535,0,0,50,60,2]},{"op":51,"name":"actor_face","args":[8,0,1]},{"op":51,"name":"actor_face","args":[0,0,3]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,6]},{"op":20,"name":"dialog","args":["&管毅\n小弟虽然久居深山，但也听恩师讲过\n那些人情冷暖。秦兄与小弟萍水相逢，\n便肯解囊相助，真慷慨义士也。\n&管毅\n不瞒秦兄讲，小弟自幼承名师指点枪棒，\n也敢自负武艺不俗。那小偷既能从我身\n上盗走钱包，想必的确有些凶险的手段。\n&管毅\n秦兄如此仗义，\n小弟岂能让你独自涉险，\n愿随兄长同去捉那恶贼。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":52,"name":"actor_action","args":[8,3]},{"op":20,"name":"dialog","args":["&秦琼\n哦，如此甚好！我观管贤弟\n气色便知你是个练家子，此次\n能得贤弟相助，何愁擒不住那恶贼！"]},{"op":52,"name":"actor_action","args":[8,0]},{"op":20,"name":"dialog","args":["&秦琼\n只是那恶贼本来就是出自山西，\n在潞州附近多有巢穴，\n他此去向南，必是去投楂树岗。\n&秦琼\n那里地势险恶，近日更是听说出了\n一批响马，我们此去可谓十分危险，\n贤弟可要想清楚了。\n&管毅\n秦兄放心，我们快走吧。\n&秦琼\n好。"]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":51,"name":"actor_face","args":[8,0,2]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":20,"name":"dialog","args":["&樊虎\n秦哥！"]},{"op":51,"name":"actor_face","args":[8,0,0]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":48,"name":"actor_appear","args":[11,42,4,2,0]},{"op":50,"name":"actor_move","args":[65535,11,0,42,52,2]},{"op":20,"name":"dialog","args":["&樊虎\n俺去北边的村子盘问过了，\n那里没有人看到过周治。\n&秦琼\n贤弟辛苦了。\n周治已经向南逃往楂树岗，\n我和这位管兄弟正要去追他。"]},{"op":52,"name":"actor_action","args":[11,2]},{"op":20,"name":"dialog","args":["&樊虎\n啊？俺又被这恶贼耍啦！"]},{"op":51,"name":"actor_face","args":[11,0,1]},{"op":20,"name":"dialog","args":["&樊虎\n哎？"]},{"op":50,"name":"actor_move","args":[65535,11,0,50,52,2]},{"op":20,"name":"dialog","args":["&樊虎\n这位小兄弟是？\n&秦琼\n这位管毅兄弟是我新结交的朋友，\n也是一位仗义侠士，\n愿意助我们擒拿周治。"]},{"op":51,"name":"actor_face","args":[8,0,1]},{"op":20,"name":"dialog","args":["&秦琼\n管贤弟，这是我的搭档，历城县捕快\n樊虎樊建威。捕盗捉贼不惜死力，\n六扇门里人送绰号「樊无命」。"]},{"op":52,"name":"actor_action","args":[0,6]},{"op":20,"name":"dialog","args":["&管毅\n久仰樊捕头大名，请多指教。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":52,"name":"actor_action","args":[11,17]},{"op":20,"name":"dialog","args":["&樊虎\n为人民服务！"]},{"op":52,"name":"actor_action","args":[11,0]},{"op":20,"name":"dialog","args":["&秦琼\n二位贤弟。"]},{"op":51,"name":"actor_face","args":[8,17,2]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":51,"name":"actor_face","args":[11,0,2]},{"op":20,"name":"dialog","args":["&秦琼\n前面去楂树岗有东西两条山路，\n我走东边，二位贤弟走西边，\n以防那恶贼中途折回，顺原路溜走。"]},{"op":52,"name":"actor_action","args":[8,0]},{"op":20,"name":"dialog","args":["&管毅\n嗯，就这么办！"]},{"op":50,"name":"actor_move","args":[65535,0,0,50,96,2]},{"op":50,"name":"actor_move","args":[65535,8,0,42,96,2]},{"op":50,"name":"actor_move","args":[65535,11,0,50,96,2]},{"op":59,"name":"join","args":[11,0,0]},{"op":59,"name":"join","args":[21,0,0]},{"op":29,"name":"fade_in","args":[]},{"op":117,"name":"set_byte_var","args":[49,0]},{"op":117,"name":"set_byte_var","args":[67,88]},{"op":117,"name":"set_byte_var","args":[70,0]},{"op":117,"name":"set_byte_var","args":[8,0]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["辎重队变阵营（友轿）"]},"end":204},{"op":117,"name":"set_byte_var","args":[406,107]},{"op":117,"name":"set_byte_var","args":[407,107]},{"op":117,"name":"set_byte_var","args":[408,107]},{"op":117,"n