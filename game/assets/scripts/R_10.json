{"file":"R_10.wagan","kind":"story","scenario_index":20,"version":[1,2],"tlv":[],"scenes":[{"index":0,"offset":18,"sections":[{"index":0,"offset":20,"title":"莽豪杰讨伐贪官","conditions":[{"op":2,"name":"comment","args":["莽豪杰讨伐贪官"]},{"op":0,"name":"end","args":[]}],"body":[{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_result","args":[0]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":[""]},"end":7},{"op":119,"name":"int_var_op","args":[2,2699,2,0,0]},{"op":113,"name":"special_func","args":[5]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[755],[]]},"end":65},{"op":39,"name":"change_scene","args":[2,65535,65535,65,65535]},{"op":48,"name":"actor_appear","args":[0,62,55,3,0]},{"op":48,"name":"actor_appear","args":[4,50,58,1,0]},{"op":48,"name":"actor_appear","args":[7,50,52,1,0]},{"op":48,"name":"actor_appear","args":[23,46,62,1,0]},{"op":48,"name":"actor_appear","args":[10,70,60,3,0]},{"op":48,"name":"actor_appear","args":[6,70,50,3,0]},{"op":48,"name":"actor_appear","args":[24,78,50,3,0]},{"op":36,"name":"play_sound","args":[43]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":24,"name":"title_text","args":["绿林道的反击"]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["南阳关外  绿林营地"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[7,2]},{"op":20,"name":"dialog","args":["&伍天锡\n可恨咱们来晚了一步，\n兄长已经不在南阳了！"]},{"op":52,"name":"actor_action","args":[7,0]},{"op":52,"name":"actor_action","args":[0,6]},{"op":20,"name":"dialog","args":["&管毅\n南阳侯虽然下落不明，但至少\n没有被隋军杀害。我们多派人\n去寻找，一定可以查出他的去向。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&单雄信\n嗯，南阳侯虽已逃亡，可是二贤庄\n和陀螺寨两路人马来到这南阳关下，\n断然没有空手而归的道理。\n&管毅\n呵呵，二员外莫不是打算\n攻打南阳关，为南阳侯报仇雪耻？\n&单雄信\n嗯，单某确有此意。不知\n南阳关被破之后，朝廷留何人镇守？"]},{"op":51,"name":"actor_face","args":[10,3,3]},{"op":20,"name":"dialog","args":["&盛彦师\n我和小丁已经打探过了。韩擒虎和宇文\n成都攻下南阳后，已经返回京城复命。\n&盛彦师\n现在杨广任命一个名叫张大新的人\n为南阳侯，带领四名镇殿将军镇守南阳。"]},{"op":52,"name":"actor_action","args":[10,0]},{"op":51,"name":"actor_face","args":[6,3,3]},{"op":20,"name":"dialog","args":["&丁天庆\n这张大新刚刚到任，却立显贪官\n本色，大肆搜刮民财。南阳城内\n城外的百姓都已怨声载道。"]},{"op":52,"name":"actor_action","args":[6,0]},{"op":52,"name":"actor_action","args":[24,2]},{"op":20,"name":"dialog","args":["&谢映登\n这张大新我是知道的，他是奸臣\n宇文化及一党。其人卑鄙无耻，\n贪墨成性，是满朝闻名的贪官。\n&谢映登\n只因他的侄女是杨广的妃子，因此现在\n他也成了皇亲国戚。此次杨广派他来接\n管南阳，南阳的百姓少不得受罪了！"]},{"op":52,"name":"actor_action","args":[24,0]},{"op":52,"name":"actor_action","args":[4,2]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["表情变化（单二微怒）"]},"end":44},{"op":119,"name":"int_var_op","args":[2,0,2,0,266]},{"op":120,"name":"data_transfer","args":[0,1,4,1]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&单雄信\n既然如此，咱们就拿下南阳关，\n砍了这狗官的脑袋，替伍氏\n一族出气，为绿林道扬名！"]},{"op":52,"name":"actor_action","args":[4,0]},{"op":51,"name":"actor_face","args":[7,3,2]},{"op":20,"name":"dialog","args":["&伍天锡\n说得好！正合伍太爷的心意！"]},{"op":51,"name":"actor_face","args":[7,0,1]},{"op":52,"name":"actor_action","args":[4,6]},{"op":20,"name":"dialog","args":["&单雄信\n管兄弟，单某是粗人，打仗出得起\n力气却动不起脑筋，二贤庄的人马\n这次还是有劳你来调度吧！"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["表情变化（单二正常）"]},"end":55},{"op":119,"name":"int_var_op","args":[2,0,2,0,5]},{"op":120,"name":"data_transfer","args":[0,1,4,1]},{"op":0,"name":"end","args":[]},{"op":52,"name":"actor_action","args":[0,6]},{"op":20,"name":"dialog","args":["&管毅\n却之不恭了。"]},{"op":52,"name":"actor_action","args":[4,0]},{"op":52,"name":"actor_action","args":[0,0]},{"op":36,"name":"play_sound","args":[45]},{"op":10,"name":"clear_flags","args":[]},{"op":116,"name":"set_4ce004","args":[1]},{"op":8,"name":"set_result","args":[1]},{"op":40,"name":"op_28","args":[1]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":1,"offset":1861,"sections":[{"index":0,"offset":1863,"title":"出战","conditions":[{"op":2,"name":"comment","args":["出战"]},{"op":7,"name":"test_pending","args":[]},{"op":0,"name":"end","args":[]}],"body":[{"op":10,"name":"clear_flags","args":[]},{"op":8,"name":"set_result","args":[0]},{"op":51,"name":"actor_face","args":[0,0,3]},{"op":20,"name":"dialog","args":["&管毅\n都准备好了么？"]},{"op":51,"name":"actor_face","args":[0,3,1]},{"op":20,"name":"dialog","args":["&管毅\n出发！"]},{"op":6,"name":"battle_select_units","args":[0,0,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":117,"name":"set_byte_var","args":[45,83]},{"op":117,"name":"set_byte_var","args":[152,83]},{"op":117,"name":"set_byte_var","args":[116,106]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":47,"name":"op_2f","args":[]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":1,"offset":2054,"title":"玩家切换","conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[24]},{"op":0,"name":"end","args":[]}],"body":[{"op":51,"name":"actor_face","args":[0,0,1]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[15],[]]},"end":6},{"op":52,"name":"actor_action","args":[24,3]},{"op":20,"name":"dialog","args":["&谢映登\n杀了张大新，给杨广一个下马威！"]},{"op":52,"name":"actor_action","args":[24,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[15]]},"end":12},{"op":52,"name":"actor_action","args":[24,3]},{"op":20,"name":"dialog","args":["&谢映登\n张大新在大兴京就是出了名的贪官\n酷吏，死心踏地依附杨广和宇文化及，\n无恶不作。今日绝不能放过他！"]},{"op":52,"name":"actor_action","args":[24,0]},{"op":11,"name":"set_flag","args":[15,1]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]},{"index":2,"offset":2333,"title":"玩家切换","conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[23]},{"op":0,"name":"end","args":[]}],"body":[{"op":51,"name":"actor_face","args":[0,0,3]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[16],[]]},"end":4},{"op":20,"name":"dialog","args":["&魏征\n南阳刚刚被朝廷攻破过一次，\n现在城防薄弱，再多的官兵也\n挡不住我们的进攻！"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[16]]},"end":8},{"op":20,"name":"dialog","args":["&魏征\n南阳关的城门在伍云召逃亡时\n被摧毁，至今都没有修好。\n现在进攻，正是时候！"]},{"op":11,"name":"set_flag","args":[16,1]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":2588,"title":"玩家切换","conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[10]},{"op":0,"name":"end","args":[]}],"body":[{"op":51,"name":"actor_face","args":[0,0,1]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[17],[]]},"end":6},{"op":52,"name":"actor_action","args":[10,3]},{"op":20,"name":"dialog","args":["&盛彦师\n张大新的人头我老盛先预定了，\n你们谁都别跟我抢！"]},{"op":52,"name":"actor_action","args":[10,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[17]]},"end":10},{"op":20,"name":"dialog","args":["&盛彦师\n听说此次朝廷讨伐伍云召，所有\n出征军兵都受到了封赏，只有一\n个都尉被降职，留在南阳关听用。\n&管毅\n哦？呵呵，\n倒霉的人什么时候都有啊。\n&盛彦师\n好像是叫什么马三保的，\n听说武艺还不错。\n&管毅\n马三保……？\n（哦，是在西漂之乱时\n放走李侯爷的那员将官吧……）"]},{"op":11,"name":"set_flag","args":[17,1]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":3017,"title":"玩家切换","conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[6]},{"op":0,"name":"end","args":[]}],"body":[{"op":51,"name":"actor_face","args":[0,0,1]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[18],[]]},"end":6},{"op":52,"name":"actor_action","args":[6,3]},{"op":20,"name":"dialog","args":["&丁天庆\n当年我们在这里被伍云召杀得\n大败，今日却又要在此替他出气报仇，\n乱世中的敌友变换真是难测。"]},{"op":52,"name":"actor_action","args":[6,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[18]]},"end":10},{"op":20,"name":"dialog","args":["&丁天庆\n忽然想起来一件事……南阳关地处\n中原腹地，四面都被隋朝的城池包围。\n即使攻下来，我们也很难守住……\n&管毅\n正因为南阳地处中原腹地，我们若能\n攻克它，就等于一拳捣在朝廷的心窝\n上。即使事后弃城不守，也很有意义。\n&丁天庆\n我明白了。攻打南阳是为了动摇朝廷\n的威望，鼓励天下反隋志士们的决心！\n&管毅\n不错。\n所以这一仗我们只能赢，不能输！"]},{"op":11,"name":"set_flag","args":[18,1]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":3563,"title":"玩家切换","conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[4]},{"op":0,"name":"end","args":[]}],"body":[{"op":51,"name":"actor_face","args":[0,0,3]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[248],[]]},"end":4},{"op":20,"name":"dialog","args":["&单雄信\n今天总算可以反击了！\n让俺单通来打头阵吧！"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[19],[248]]},"end":12},{"op":20,"name":"dialog","args":["&单雄信\n贤弟，现在就做战前部署么？"]},{"op":1,"name":"if","args":[],"cond":{"op":4,"name":"test_yes_no","args":[1]},"end":11},{"op":40,"name":"op_28","args":[0]},{"op":6,"name":"battle_select_units","args":[1,5,4,23,24,10,6,65535,65535,65535,65535,65535]},{"op":11,"name":"set_flag","args":[248,1]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[19]]},"end":18},{"op":52,"name":"actor_action","args":[4,3]},{"op":20,"name":"dialog","args":["&单雄信\n自从哥哥死后，绿林道一直被\n官兵追着打，今天总算可以反\n击了！让俺单通来打头阵吧！"]},{"op":52,"name":"actor_action","args":[4,0]},{"op":11,"name":"set_flag","args":[19,1]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":3960,"title":"玩家切换","conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[7]},{"op":0,"name":"end","args":[]}],"body":[{"op":51,"name":"actor_face","args":[0,0,3]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[20],[]]},"end":6},{"op":52,"name":"actor_action","args":[7,2]},{"op":20,"name":"dialog","args":["&伍天锡\n哼，姓雄的这次又言而无信！\n不等他了，咱们出兵吧！"]},{"op":52,"name":"actor_action","args":[7,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[20]]},"end":18},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["头像变化（管毅囧·新）"]},"end":11},{"op":119,"name":"int_var_op","args":[2,0,2,0,5]},{"op":120,"name":"data_transfer","args":[0,1,0,1]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&伍天锡\n姓雄的说回金顶太行山去\n领了人马，马上就赶来助阵。\n怎么至今还不见动静？\n&管毅\n……\n（多半儿是又迷路了吧……）"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["头像变化（管毅正常·新）"]},"end":16},{"op":119,"name":"int_var_op","args":[2,0,2,0,0]},{"op":120,"name":"data_transfer","args":[0,1,0,1]},{"op":0,"name":"end","args":[]},{"op":11,"name":"set_flag","args":[20,1]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]}]}]}