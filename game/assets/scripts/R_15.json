"name":"actor_action","args":[8,0]},{"op":11,"name":"set_flag","args":[23,1]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_result","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":4278,"title":"玩家切换","conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[4]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_result","args":[0]},{"op":50,"name":"actor_move","args":[65535,0,0,50,60,3]},{"op":52,"name":"actor_action","args":[4,3]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["表情变化（单二微怒）"]},"end":8},{"op":120,"name":"data_transfer","args":[0,0,4,1]},{"op":119,"name":"int_var_op","args":[2,0,2,0,266]},{"op":120,"name":"data_transfer","args":[0,1,4,1]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[24],[]]},"end":11},{"op":20,"name":"dialog","args":["&单雄信\n单某生平最瞧不起背主无义之人，\n似董平之辈，杀了他我都嫌脏了手！"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[24]]},"end":15},{"op":20,"name":"dialog","args":["&单雄信\n董平背叛首领，谋夺瓦岗寨，\n这样的贼子人人得而诛之，\n他怎么可能挡得住我们正义之师？"]},{"op":11,"name":"set_flag","args":[24,1]},{"op":0,"name":"end","args":[]},{"op":52,"name":"actor_action","args":[4,0]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["表情变化（单二正常）"]},"end":21},{"op":120,"name":"data_transfer","args":[0,0,4,1]},{"op":119,"name":"int_var_op","args":[2,0,2,0,5]},{"op":120,"name":"data_transfer","args":[0,1,4,1]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_result","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":4782,"title":"玩家切换","conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[1]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_result","args":[0]},{"op":50,"name":"actor_move","args":[65535,0,0,50,66,3]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[25],[]]},"end":16},{"op":52,"name":"actor_action","args":[1,2]},{"op":20,"name":"dialog","args":["&程咬金\n让俺打头阵也行！俺要是\n让人家砍死了，俺娘归你养活！"]},{"op":52,"name":"actor_action","args":[1,0]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["头像变化（管毅笑·新）"]},"end":10},{"op":119,"name":"int_var_op","args":[2,0,2,0,3]},{"op":120,"name":"data_transfer","args":[0,1,0,1]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&管毅\n哈哈哈，我对四哥有信心，\n你打头阵肯定没问题！"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["头像变化（管毅正常·新）"]},"end":15},{"op":119,"name":"int_var_op","args":[2,0,2,0,0]},{"op":120,"name":"data_transfer","args":[0,1,0,1]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[25]]},"end":44},{"op":20,"name":"dialog","args":["&程咬金\n吽吽吽，管兄弟，俺跟你商量个\n事儿……三哥徐老道这次好像又\n咕叨着俺去打头阵。\n&程咬金\n老程这两下子你都清楚，三斧子砍不着\n人家，自己就得玩儿完。待会儿大哥问\n起来，你可别帮着徐老道说话……\n&管毅\n呵呵，金堤关一仗打下来，别的兄弟都\n累熊了，就四哥你还生龙活虎的。要我\n说，攻打瓦岗寨的头阵还就得你来打。"]},{"op":52,"name":"actor_action","args":[1,2]},{"op":20,"name":"dialog","args":["&程咬金\n吽？管兄弟，咱哥儿俩平日里\n可不错呀！你别害俺老程啊！"]},{"op":52,"name":"actor_action","args":[1,0]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["头像变化（管毅笑·新）"]},"end":25},{"op":119,"name":"int_var_op","args":[2,0,2,0,3]},{"op":120,"name":"data_transfer","args":[0,1,0,1]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&管毅\n哈哈哈，打下瓦岗寨可是\n天大的功劳，要不是关系好，\n我还不把这机会让给四哥呢！"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["头像变化（管毅正常·新）"]},"end":30},{"op":119,"name":"int_var_op","args":[2,0,2,0,0]},{"op":120,"name":"data_transfer","args":[0,1,0,1]},{"op":0,"name":"end","args":[]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["头像变化（程悲）"]},"end":36},{"op":120,"name":"data_transfer","args":[0,0,1,1]},{"op":119,"name":"int_var_op","args":[2,0,2,0,219]},{"op":120,"name":"data_transfer","args":[0,1,1,1]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&程咬金\n什么功劳……\n分明是想让老程掉脑袋……"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["头像变化（程正常）"]},"end":42},{"op":120,"name":"data_transfer","args":[0,0,1,1]},{"op":119,"name":"int_var_op","args":[2,0,2,0,216]},{"op":120,"name":"data_transfer","args":[0,1,1,1]},{"op":0,"name":"end","args":[]},{"op":11,"name":"set_flag","args":[25,1]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_result","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":6095,"title":"玩家切换","conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[15]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_result","args":[0]},{"op":50,"name":"actor_move","args":[65535,0,0,50,72,3]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[26],[]]},"end":5},{"op":20,"name":"dialog","args":["&罗士信\n哥打到哪，傻子跟到哪……"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[26]]},"end":9},{"op":20,"name":"dialog","args":["&管毅\n傻子兄弟，待会儿上了战场可得紧跟着\n秦二哥，别让自己落了单儿，\n也别让二哥出危险，知道么？\n&罗士信\n傻子跟着哥，落不了单儿。\n哥有傻子保着，没危险。"]},{"op":11,"name":"set_flag","args":[26,1]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_result","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":6406,"title":"玩家切换","conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[22]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_result","args":[0]},{"op":50,"name":"actor_move","args":[65535,0,0,60,54,1]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[27],[]]},"end":5},{"op":20,"name":"dialog","args":["&徐茂功\n董平多谋，不可轻敌。"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[27]]},"end":13},{"op":20,"name":"dialog","args":["&管毅\n三哥可知这「神笔」董平的根底么？"]},{"op":51,"name":"actor_face","args":[22,0,2]},{"op":20,"name":"dialog","args":["&徐茂功\n董平本是瓦岗寨的军师，翟让手下的\n得力干将。只因与花家兄弟不和，唯\n恐自己被翟让疏远，这才发动叛乱。"]},{"op":51,"name":"actor_face","args":[22,0,3]},{"op":20,"name":"dialog","args":["&徐茂功\n此人智谋过人，不可小觑。更兼部下\n有三员大将，薛勇、吴季和张千，个\n个都有过人之能。\n&徐茂功\n我军与他们交手，还须多加小心。"]},{"op":11,"name":"set_flag","args":[27,1]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_result","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":6874,"title":"玩家切换","conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[20]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_result","args":[0]},{"op":50,"name":"actor_move","args":[65535,0,0,60,60,1]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[28],[]]},"end":5},{"op":20,"name":"dialog","args":["&贾润甫\n仅留尉迟双雄留守金堤关，\n到底让人放心不下。\n就算再加上柳周臣，还是……"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[28]]},"end":19},{"op":20,"name":"dialog","args":["&贾润甫\n我军进攻瓦岗山，金堤关\n本身的防守就会变得薄弱。\n&管毅\n徐三哥已指命尉迟南和尉迟北\n守卫金堤关，贾兄不必担心了。\n&贾润甫\n哦，是尉迟双雄么？……\n仅靠他们两兄弟留守金堤关，\n到底还是让人放心不下。"]},{"op":51,"name":"actor_face","args":[31,0,0]},{"op":51,"name":"actor_face","args":[20,0,2]},{"op":52,"name":"actor_action","args":[31,3]},{"op":20,"name":"dialog","args":["&柳周臣\n掌柜的，我留下来\n帮他们一起守关吧！"]},{"op":52,"name":"actor_action","args":[31,0]},{"op":52,"name":"actor_action","args":[20,2]},{"op":20,"name":"dialog","args":["&贾润甫\n你倒会挑轻省的事做！"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":51,"name":"actor_face","args":[20,0,3]},{"op":51,"name":"actor_face","args":[31,0,3]},{"op":11,"name":"set_flag","args":[28,1]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_result","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":7456,"title":"玩家切换","conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[31]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_result","args":[0]},{"op":50,"name":"actor_move","args":[65535,0,0,60,66,1]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[29],[]]},"end":5},{"op":20,"name":"dialog","args":["&柳周臣\n新武器和新装备在战场上\n应该会发挥很大作用。"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[29]]},"end":9},{"op":20,"name":"dialog","args":["&柳周臣\n金堤关的武器商人为我们提供了一些\n新的兵器和装备，管兄不妨采购几件。"]},{"op":11,"name":"set_flag","args":[29,1]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_result","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":9,"offset":7711,"title":"玩家切换","conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[30]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_result","args":[0]},{"op":50,"name":"actor_move","args":[65535,0,0,60,72,1]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[30],[]]},"end":5},{"op":20,"name":"dialog","args":["&上官狄\n没脸再见靠山王了……"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[30]]},"end":9},{"op":20,"name":"dialog","args":["&上官狄\n本想做个好主簿，报答靠山王老千岁的\n知遇之恩，可到底还是跟着秦兄加入了\n「英雄会」，看来这真是天意……\n&管毅\n（唔……上官兄弟对\n老杨林还是念念不忘啊。）"]},{"op":11,"name":"set_flag","args":[30,1]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_result","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}